{
  "name": "ammar-family-heritage",
  "private": true,
  "version": "1.0.0",
  "description": "Ammar Syaathir Family Heritage Archive: plain HTML + CSS + JS front end with Cloudflare Pages Functions and D1.",
  "scripts": {
    "db:local": "wrangler d1 execute ammar-family-d1 --local --file=db/schema.sql",
    "dev": "wrangler pages dev dist",
    "db:remote": "wrangler d1 execute ammar-family-d1 --remote --file=db/schema.sql",
    "deploy": "wrangler pages deploy dist --project-name ammar-family-heritage"
  },
  "devDependencies": {
    "wrangler": "^4"
  }
}
